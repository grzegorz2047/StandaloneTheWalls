# Sunderfront reliable TLS process configuration
# Presence of --tls-config enables the endpoint. It always requires --identity-config.
transport.schema=1
transport.reliable.bind-address=0.0.0.0
transport.reliable.private-key-pkcs8-path=server-ed25519-key.pk8
transport.reliable.certificate-x509-path=server-ed25519-certificate.der
transport.reliable.backlog=128
transport.reliable.maximum-concurrent-handshakes=16
transport.reliable.maximum-active-connections=40
transport.reliable.handshake-timeout-seconds=10
transport.reliable.shutdown-timeout-seconds=5
transport.identity.challenge-lifetime-seconds=30
transport.identity.maximum-outstanding-challenges=40
transport.identity.result-send-timeout-seconds=5
transport.identity.gateway-shutdown-timeout-seconds=5
